    "deployment_approver": {"minimum_repository_permission": "write", "actor_ids": [1]}
  },
  "project": {
    "adapter": "java_maven", "toolchain_id": "fixture-java8", "rules_source": "repository",
    "command_overrides": {}, "junit_report_patterns": ["**/target/surefire-reports/TEST-*.xml"]
  },
  "knowledge": {"adr_path_if_absent": "docs/adr", "kb_path_if_absent": "docs/knowledge"},
