    {"id": "unconfigured-protocol", "operation": "preflight", "purpose": "implementation", "config_patch": [{"op": "set", "path": ["llm", "providers", "internal", "adapter"], "value": "unconfigured"}], "expected": {"outcome": "preflight", "status": "configuration_pending", "reasons": ["ADAPTER_UNCONFIGURED"], "adapter_calls": 0}},
    {"id": "missing-auth", "operation": "dispatch", "purpose": "implementation", "environment_patch": {"EVAL_MODEL_TOKEN": null}, "expected": {"outcome": "error", "code": "MODEL_NOT_CONFIGURED", "adapter_calls": 0}},
    {"id": "unknown-tool-support", "operation": "preflight", "purpose": "implementation", "config_patch": [{"op": "set", "path": ["llm", "models", "alpha", "capabilities", "tool_calls"], "value": "unknown"}], "expected": {"outcome": "preflight", "status": "configuration_pending", "reasons": ["TOOLS_UNCONFIRMED"], "adapter_calls": 0}},
    {"id": "text-model-coding-denied", "operation": "dispatch", "purpose": "implementation", "repository_patch": [{"op": "set", "path": ["model_routing", "default_model"], "value": "text-only"}], "expected": {"outcome": "error", "code": "MODEL_DENIED", "adapter_calls": 0}},
    {"id": "text-model-summary-allowed", "operation": "dispatch", "purpose": "summary", "repository_patch": [{"op": "set", "path": ["model_routing", "default_model"], "value": "text-only"}], "expected": {"outcome": "dispatched", "model_id": "text-only", "adapter_calls": 1}},
    {"id": "disabled-repo-denied", "operation": "dispatch", "purpose": "implementation", "repository_patch": [{"op": "set", "path": ["enabled"], "value": false}], "expected": {"outcome": "error", "code": "MODEL_DENIED", "adapter_calls": 0}},
    {"id": "no-model-fallback-on-error", "operation": "dispatch", "purpose": "implementation", "stub_failure": true, "expected": {"outcome": "error", "code": "MODEL_ADAPTER_ERROR", "adapter_calls": 1}},
    {"id": "missing-limits", "operation": "preflight", "purpose": "implementation", "config_patch": [{"op": "set", "path": ["llm", "models", "alpha", "context_window_tokens"], "value": null}], "expected": {"outcome": "preflight", "status": "configuration_pending", "reasons": ["MODEL_LIMITS_UNCONFIGURED"], "adapter_calls": 0}},
    {"id": "reject-boolean-concurrency", "operation": "validate", "config_patch": [{"op": "set", "path": ["llm", "providers", "internal", "max_concurrent_requests"], "value": true}], "expected": {"outcome": "error", "code": "CONFIG_TYPE", "adapter_calls": 0}},
    {"id": "reject-unknown-setting", "operation": "validate", "config_patch": [{"op": "set", "path": ["network", "unsafe_fallback"], "value": true}], "expected": {"outcome": "error", "code": "CONFIG_UNKNOWN_FIELD", "adapter_calls": 0}},
    {"id": "reject-old-model-section", "operation": "validate", "config_patch": [{"op": "set", "path": ["model"], "value": {}}], "expected": {"outcome": "error", "code": "CONFIG_UNKNOWN_FIELD", "adapter_calls": 0}},
    {"id": "overlapping-state-workspace", "operation": "validate", "config_patch": [{"op": "set", "path": ["storage", "state_dir"], "value": "local-data/workspaces/state"}], "expected": {"outcome": "error", "code": "CONFIG_PATH_OVERLAP", "adapter_calls": 0}},
    {"id": "cannot-disable-requirement-approval", "operation": "validate", "repository_patch": [{"op": "set", "path": ["workflow", "requirement_approval_required"], "value": false}], "expected": {"outcome": "error", "code": "APPROVAL_REQUIRED", "adapter_calls": 0}}
  ]
}
