    {"id": "nonstandard-port", "operation": "authorize_destination", "url": "https://models.internal.invalid:8443/v1", "expected": {"outcome": "error", "code": "NETWORK_URL", "adapter_calls": 0}},
    {"id": "redirects-denied", "operation": "validate", "config_patch": [{"op": "set", "path": ["network", "follow_redirects"], "value": true}], "expected": {"outcome": "error", "code": "NETWORK_REDIRECT", "adapter_calls": 0}},
