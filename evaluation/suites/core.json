    {"id": "global-purpose", "operation": "resolve", "purpose": "design", "expected": {"outcome": "resolved", "model_id": "beta", "provider_id": "internal", "route_source": "global.purpose", "adapter_calls": 0}},
    {"id": "repo-default-precedence", "operation": "resolve", "purpose": "design", "repository_patch": [{"op": "set", "path": ["model_routing", "default_model"], "value": "alpha"}], "expected": {"outcome": "resolved", "model_id": "alpha", "provider_id": "internal", "route_source": "repository.default", "adapter_calls": 0}},
    {"id": "repo-purpose-precedence", "operation": "resolve", "purpose": "implementation", "repository_patch": [{"op": "set", "path": ["model_routing", "default_model"], "value": "alpha"}, {"op": "set", "path": ["model_routing", "by_purpose", "implementation"], "value": "beta"}], "expected": {"outcome": "resolved", "model_id": "beta", "provider_id": "internal", "route_source": "repository.purpose", "adapter_calls": 0}},
    {"id": "no-allowlist-fallback", "operation": "dispatch", "purpose": "design", "repository_patch": [{"op": "set", "path": ["model_routing", "allowed_models"], "value": ["alpha"]}], "expected": {"outcome": "error", "code": "MODEL_NOT_ALLOWED", "adapter_calls": 0}},
