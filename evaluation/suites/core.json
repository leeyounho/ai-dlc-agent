    {"id": "internal-label-external-url", "operation": "dispatch", "purpose": "implementation", "config_patch": [{"op": "set", "path": ["llm", "providers", "internal", "base_url"], "value": "https://external.invalid/v1"}], "expected": {"outcome": "error", "code": "NETWORK_DENIED", "adapter_calls": 0}},
    {"id": "external-test-explicit", "operation": "dispatch", "purpose": "implementation", "config_patch": [{"op": "set", "path": ["profile"], "value": "test"}, {"op": "set", "path": ["network", "external_access"], "value": true}, {"op": "set", "path": ["network", "external_hosts"], "value": ["external.invalid"]}, {"op": "set", "path": ["llm", "providers", "internal", "boundary"], "value": "external"}, {"op": "set", "path": ["llm", "providers", "internal", "base_url"], "value": "https://external.invalid/v1"}], "expected": {"outcome": "dispatched", "model_id": "alpha", "adapter_calls": 1}},
    {"id": "forbidden-destination", "operation": "authorize_destination", "url": "https://forbidden.invalid", "expected": {"outcome": "error", "code": "NETWORK_DENIED", "adapter_calls": 0}},
